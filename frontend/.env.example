# URL du backend. Lue uniquement côté serveur (pas de préfixe NEXT_PUBLIC_) :
# tous les appels à l'API passent par le serveur Next.
API_URL=http://localhost:8000

# Clé de l'API Gemini pour la génération de tâches par IA (gratuite sur
# https://aistudio.google.com). Lue uniquement côté serveur.
GEMINI_API_KEY=
# Optionnel : modèle Gemini utilisé (par défaut gemini-3.1-flash-lite).
# GEMINI_MODEL=gemini-3.1-flash-lite
